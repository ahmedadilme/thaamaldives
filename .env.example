# ---------------------------------------------------------------------------
#  Storage (mvcdn / S3-compatible)
# ---------------------------------------------------------------------------
#  Two separate groups. Only the VITE_* group is exposed to the browser —
#  the R2_* group holds credentials and must stay server-side.
#
#  R2_*   read by r2-signer-dev.ts (Vite dev middleware) and by the deployed
#         nextjs-uploader service. Never prefixed with VITE_.
#  VITE_* read by src/lib/r2.ts, inlined into the client bundle at build time.

# --- server-side secrets: never shipped to the browser ---------------------
R2_ENDPOINT=https://<account>.mvcdn.com
R2_REGION=us-east-1
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Public host for the bucket. Accepts a value WITH or WITHOUT a scheme
# (https:// is added for you if you omit it). Both signers build:
#   https://{R2_PUBLIC_URL}/s3/{R2_BUCKET}/{key}
# Leaving it empty makes the signers refuse to mint, rather than hand back a
# malformed URL that would be saved into a CMS media field.
R2_PUBLIC_URL=

# --- public values: safe to ship, required at build time -------------------
# Must match R2_PUBLIC_URL / R2_BUCKET above.
VITE_R2_PUBLIC_URL=
VITE_R2_BUCKET=

# Base URL of the signer that mints presigned PUTs.
#   dev  -> LEAVE EMPTY. The dev signer is same-origin at /api/presign-put,
#           so an empty value correctly resolves to the current origin.
#   prod -> the deployed nextjs-uploader origin, e.g. https://uploader.example.com
VITE_R2_SIGNER_URL=

# --- nextjs-uploader only ---------------------------------------------------
# LEAVE THIS UNSET on the deployed uploader.
#
# When set, /api/presign-put rejects any request without a matching
# x-admin-secret header — and the SPA cannot send one, because a public client
# bundle must never hold a shared secret. Setting it would 401 every upload.
#
# An open presign endpoint is safe here: the bucket is public and the route only
# ever mints short-lived presigned PUT URLs. It grants no read, no delete, and
# no access to any key the caller did not name.
ADMIN_SECRET=
