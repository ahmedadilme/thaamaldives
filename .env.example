# ---------------------------------------------------------------------------
#  Storage (mvcdn / S3-compatible) + media library
# ---------------------------------------------------------------------------
#  Two separate groups. Only the VITE_* group is exposed to the browser —
#  the R2_* group holds credentials and must stay server-side.
#
#  R2_*   read by r2-signer-dev.ts (Vite dev middleware) and by the deployed
#         nextjs-uploader service. Never prefixed with VITE_.
#  VITE_* read by src/lib/r2.ts, inlined into the client bundle at build time.

# --- server-side secrets: never shipped to the browser ---------------------
R2_ENDPOINT=https://<account>.mvcdn.com/s3
R2_REGION=us-east-1
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Public root of the bucket (optional). Uploads build the public URL from
# R2_ENDPOINT + R2_BUCKET instead:
#   {R2_ENDPOINT}/{R2_BUCKET}/{key}   e.g. https://cdn.mvcdn.cc/s3/xxx/media/…
R2_PUBLIC_URL=

# --- public values: safe to ship, required at build time -------------------
# Must match the bucket the R2_BUCKET above points at.
VITE_R2_PUBLIC_URL=
VITE_R2_BUCKET=

# Base URL of the uploader that receives /api/upload and serves the media
# library /api/media.
#   dev  -> LEAVE EMPTY. The dev uploader (Vite dev-middleware) is same-origin
#           at /api/upload and /api/media.
#   prod -> the deployed nextjs-uploader origin, e.g. https://uploader.example.com
#           Must NOT end with a slash.
VITE_R2_SIGNER_URL=

# --- nextjs-uploader only ---------------------------------------------------
# Postgres for the media library index (MediaFile table). Required by the
# deployed uploader; ignored by the dev middleware (dev keeps the library
# in-memory and resets on restart).
DATABASE_URL=

# Shared secret for the legacy /api/presign-put route only. LEAVE IT UNSET.
#
# When set, that route rejects requests without a matching x-admin-secret
# header — and the SPA cannot send one, because a public client bundle must
# never hold a shared secret. Setting it would break that route.
#
# The live path (POST /api/upload) has no secret check and needs none: it only
# writes into your own public bucket, and the bucket is world-readable anyway.

# ---------------------------------------------------------------------------
#  Admin access
# ---------------------------------------------------------------------------
# Password for /admin. Leave it EMPTY and the admin area stays LOCKED (it will
# show setup instructions) — there is no open-by-default fallback.
#
# This is a browser-side check, so the value ends up in the JS bundle. Treat it
# as a deterrent that keeps /admin off the public map, and ALSO protect the
# route at your host or CDN (basic auth, Cloudflare Access, Vercel/Netlify
# password). Dev builds may bypass it while the value is empty.
VITE_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
#  Lead capture (enquiries, newsletter, bookings)
# ---------------------------------------------------------------------------
# Real HTTP endpoint that the three public forms POST to. Without it the forms
# report a clear "not configured" failure rather than faking success.
#
# Works with any form backend that accepts urlencoded POSTs and honours
# `Accept: application/json`, e.g.
#   Formspree  https://formspree.io/f/xxxxxxxx
#   Basin      https://usebasin.com/api/v1/xxxxxxxx
#   Getform    https://getform.io/f/xxxxxxxx
#   Web3Forms  https://api.web3forms.com/submit   (also needs an access key)
#
# Each submission is tagged with a `kind` field: enquiry | newsletter | booking.
VITE_ENQUIRY_ENDPOINT=