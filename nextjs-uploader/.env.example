# Next.js uploader — R2 storage credentials + media library DB
# Copy to .env.local (or your host env) and fill in.

# Object storage (mvcdn.cc / S3-compatible)
R2_ENDPOINT=https://cdn.mvcdn.cc/s3
R2_REGION=us-east-1
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=https://cdn.mvcdn.cc/s3

# Postgres for the media library index
DATABASE_URL=